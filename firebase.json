{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/.*/**",
      ".git/**",
      ".claude/**",
      ".firebase/**",
      "**/node_modules/**",
      "tests/**",
      "tools/**",
      "legacy/**",
      "package.json",
      "package-lock.json",
      "database.rules.json",
      "README.md"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ],
    "cleanUrls": true
  },
  "database": {
    "rules": "database.rules.json"
  }
}
